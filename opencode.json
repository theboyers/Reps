{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "develop",
  "watcher": {
    "ignore": [
      ".git/**",
      ".gradle/**",
      "build/**",
      "**/build/**",
      ".idea/**",
      "gh-pages/**"
    ]
  },
  "permissions": [
    {
      "action": "bash",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "git diff*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "git log*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "git branch*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "git show*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "git rev-parse*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*gradlew* test*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*gradlew* check*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*gradlew* lint*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*gradlew* assembleDebug*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*gradlew* compileDebug*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*gradlew* ktlint*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*gradlew* --dry-run*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "git push*",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "git reset --hard*",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "git clean*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*local.properties",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*keystore*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.jks",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "build/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/build/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".gradle/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".idea/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "gh-pages/**",
      "effect": "deny"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "lsp",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "task",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "doom_loop",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "plan": {
      "model": "deepseek/deepseek-v4.1-flash",
      "mode": "primary",
      "description": "Software architect and planning agent. Analyzes codebase requirements, creates step-by-step implementation roadmaps, and designs architectures without mutating code.",
      "steps": 20,
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "bash",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "bash",
          "resource": "git status*",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git log*",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "git branch*",
          "effect": "allow"
        }
      ]
    },
    "develop": {
      "model": "deepseek/deepseek-v4.1-flash",
      "mode": "primary",
      "description": "Primary development agent for implementing features, refactoring, and fixing bugs in Kotlin and Jetpack Compose.",
      "steps": 30,
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "test": {
      "model": "deepseek/deepseek-v4.1-flash",
      "mode": "all",
      "description": "Testing and QA specialist. Executes test suites, analyzes test failures, and writes comprehensive unit and integration tests.",
      "steps": 25,
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "edit",
          "resource": "app/src/test/**",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "app/src/androidTest/**",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*Test.kt",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "write",
          "resource": "app/src/test/**",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": "app/src/androidTest/**",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "*gradlew* test*",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "*gradlew* check*",
          "effect": "allow"
        },
        {
          "action": "bash",
          "resource": "*gradlew* lint*",
          "effect": "allow"
        }
      ]
    },
    "ui-ux": {
      "model": "deepseek/deepseek-v4.1-flash",
      "mode": "all",
      "description": "UI/UX design specialist. Focuses on Jetpack Compose design systems, Material Design 3, color palettes, animations, layout ergonomics, and accessibility.",
      "steps": 25,
      "permissions": [
        {
          "action": "edit",
          "resource": "app/src/main/java/net/theboyers/reps/ui/**",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "app/src/main/java/net/theboyers/reps/RoutineTrackerScreen.kt",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "app/src/main/res/**",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": "app/src/main/java/net/theboyers/reps/ui/**",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": "app/src/main/res/**",
          "effect": "allow"
        }
      ]
    }
  }
}
